{
  "name": "after-hours-stations-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8799",
    "test:engine": "node --test tests/game.test.mjs tests/stations.test.mjs tests/karaoke.test.mjs",
    "test:worker": "node tests/worker.test.mjs",
